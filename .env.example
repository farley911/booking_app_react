# Arbitrary placeholders. The port below is not a recommendation.
# Replace them from the application once the host and port are known.
# If a scaffold was used, take the values from the completed scaffold.
# Prompt only for values the app does not already define.
#
# They may be the same locally. `pnpm run start` should serve START_URL.

# Local URL served by `pnpm run start`.
START_URL=http://localhost:3000

# URL scanned by axe and the quality-gate hook.
# Use START_URL for local work. Use the deployed URL in other environments.
APP_URL=http://localhost:3000
