    "globals": "^17.11.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "sass": "^1.92.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "ts-jest": "^29.4.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0"
