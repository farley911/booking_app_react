    "@betterer/cli": "^6.0.0-alpha.1",
    "@betterer/constraints": "^6.0.0-alpha.1",
    "@betterer/regexp": "^6.0.0-alpha.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@playwright/test": "^1.55.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.9.0",
