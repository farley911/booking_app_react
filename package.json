{
  "name": "booking-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{scss,css}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "betterer": "betterer",
    "betterer:ci": "betterer ci",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:styles && pnpm run test:coverage && pnpm run test:e2e && pnpm run betterer:ci && pnpm run build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
